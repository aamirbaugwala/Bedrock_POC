# Copy to .env and fill in. .env is git-ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=        # only if using temporary creds
AWS_REGION=ap-south-1
MODEL_ID=apac.amazon.nova-pro-v1:0   # Bedrock inference-profile ID for AWS_REGION
ALPHAVANTAGE_API_KEY=     # free key: https://www.alphavantage.co/support/#api-key (25 requests/day)
